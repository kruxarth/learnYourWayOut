# Copy to server/.env and fill in. server/.env is gitignored: never commit a real key.
PORT=8787
# or set OPENROUTER_KEY in the root .env (see ../.env.example); LLM_API_KEY wins
LLM_API_KEY=
# any OpenAI-compatible /chat/completions base; default OpenRouter
LLM_BASE_URL=https://openrouter.ai/api/v1
# comma-separated, tried in order; the next one takes over when one fails or is rate-limited
# default: the free OpenRouter models listed in server/env.ts
LLM_MODELS=
# optional; defaults to the first model
LLM_REVIEW_MODEL=
# on/off: model reasoning. Default off (it counts against max_tokens, truncates the JSON and is slow)
LLM_THINKING=
ALLOWED_ORIGINS=http://localhost:5173
