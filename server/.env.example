# Copy to server/.env and fill in. server/.env is gitignored: never commit a real key.
PORT=8787
# Normally set GROQ_API and/or OPENROUTER_KEY in the root .env (see ../.env.example); the default model chain is in env.ts.
# Use these only to point at one provider of your own:
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
# comma-separated, tried in order
LLM_MODELS=
# optional; defaults to the first model
LLM_REVIEW_MODEL=
# on: leave the model's hidden reasoning on (default off: it eats max_tokens and is slow)
LLM_THINKING=
ALLOWED_ORIGINS=http://localhost:5173
