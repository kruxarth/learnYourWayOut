# Copy to server/.env and fill in. server/.env is gitignored: never commit a real key.
PORT=8787
# GROQ_API goes in the root .env (see ../.env.example); the model list is in env.ts
# optional; defaults to the first model
LLM_REVIEW_MODEL=
# on: leave the model's hidden reasoning on (default off: it eats max_tokens and is slow)
LLM_THINKING=
ALLOWED_ORIGINS=http://localhost:5173
