# Copy to server/.env and fill in. server/.env is gitignored: never commit a real key.
PORT=8787
# any OpenAI-compatible /chat/completions base
LLM_BASE_URL=https://api.deepseek.com
# or set DEEPSEEK_API in the root .env (see ../.env.example); LLM_API_KEY wins
LLM_API_KEY=
# check the provider's current model list first
LLM_MODEL=deepseek-flash
# optional; defaults to LLM_MODEL
LLM_REVIEW_MODEL=
# on/off: model reasoning. Default off for api.deepseek.com (it counts against max_tokens and truncates the JSON)
LLM_THINKING=
ALLOWED_ORIGINS=http://localhost:5173
